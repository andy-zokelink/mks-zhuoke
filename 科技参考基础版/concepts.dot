digraph MKS {
    rankdir=TB;
    fontname="Noto Sans SC,SimHei,sans-serif";
    bgcolor="#fdf6ec00";
    node [fontname="Noto Sans SC,SimHei,sans-serif", fontsize=14, penwidth=2];
    edge [fontname="Noto Sans SC,SimHei,sans-serif", fontsize=11, penwidth=1.8];

    // Legend subgraph
    subgraph cluster_legend {
        label="图例";
        fontsize=13;
        style=filled;
        fillcolor="#fffaf2";
        color="#e8d5c4";
        penwidth=1.5;

        legend_method [label="方法论工具", shape=box, style=filled, fillcolor="#d4e6f1", fontsize=11, width=1.2, height=0.4];
        legend_system [label="系统动力学", shape=box, style=filled, fillcolor="#d5f5e3", fontsize=11, width=1.2, height=0.4];
        legend_apply [label="应用与表现层", shape=box, style=filled, fillcolor="#fdebd0", fontsize=11, width=1.2, height=0.4];
        legend_feedback [label="┅ 回环反馈", shape=plaintext, fontsize=10];

        legend_method -> legend_system -> legend_apply [style=invis];
    }

    // ===== 方法论工具层 (Methodology - Blue) =====
    node [style=filled, fillcolor="#d4e6f1", color="#2980b9"];

    possibility [label="可能性空间\nPossibility Space", shape=box, width=1.8, height=0.7];
    information [label="信息量化\nInformation Quantification", shape=box, width=1.8, height=0.7];
    verification [label="科学验证机制\nScientific Verification", shape=box, width=1.8, height=0.7];
    engineering [label="工程师思维\nEngineer's Mindset", shape=box, width=1.8, height=0.7];

    // ===== 系统动力学层 (System Dynamics - Green) =====
    node [style=filled, fillcolor="#d5f5e3", color="#27ae60"];

    feedback [label="反馈回路\nFeedback Loops", shape=box, width=1.8, height=0.7];
    network [label="网络传播动力学\nNetwork Propagation", shape=box, width=1.8, height=0.7];
    complexity [label="复杂系统涌现\nComplex Emergence", shape=box, width=1.8, height=0.7];

    // ===== 应用与表现层 (Application - Orange) =====
    node [style=filled, fillcolor="#fdebd0", color="#e67e22"];

    evolution [label="演化算法\nEvolutionary Algorithms", shape=box, width=1.8, height=0.7];
    energy [label="能量转换效率\nEnergy Conversion", shape=box, width=1.8, height=0.7];
    adoption [label="技术采用曲线\nTech Adoption Curve", shape=box, width=1.8, height=0.7];

    // ===== Edges =====

    // Possibility Space -> others
    possibility -> evolution [label="提供分析框架", color="#2980b9", fontcolor="#2c3e50"];
    possibility -> engineering [label="约束条件定义", color="#2980b9", fontcolor="#2c3e50"];

    // Feedback -> others
    feedback -> network [label="调节传播速率", color="#27ae60", fontcolor="#2c3e50"];
    feedback -> complexity [label="稳定与失衡机制", color="#27ae60", fontcolor="#2c3e50"];
    feedback -> evolution [label="选择压力", style=dashed, color="#7f8c8d", fontcolor="#7f8c8d"];

    // Network -> others
    network -> adoption [label="底层传播逻辑", color="#e67e22", fontcolor="#2c3e50"];
    network -> complexity [label="网络化涌现", color="#27ae60", fontcolor="#2c3e50"];

    // Evolution -> others
    evolution -> complexity [label="解释涌现机制", color="#27ae60", fontcolor="#2c3e50"];
    evolution -> information [label="优化搜索策略", color="#2980b9", fontcolor="#2c3e50"];

    // Information -> others
    information -> verification [label="提供测量基础", color="#2980b9", fontcolor="#2c3e50"];
    information -> energy [label="量化效率指标", color="#e67e22", fontcolor="#2c3e50"];

    // Engineering -> others
    engineering -> verification [label="实践检验方法", color="#2980b9", fontcolor="#2c3e50"];
    engineering -> energy [label="工程优化目标", color="#e67e22", fontcolor="#2c3e50"];

    // Complexity -> others
    complexity -> adoption [label="系统级行为", color="#e67e22", fontcolor="#2c3e50"];

    // Verification -> Evolution (dashed feedback)
    verification -> evolution [label="淘汰错误理论", style=dashed, color="#7f8c8d", fontcolor="#7f8c8d"];

    // Energy -> Engineering (dashed feedback)
    energy -> engineering [label="技术可行性约束", style=dashed, color="#7f8c8d", fontcolor="#7f8c8d"];

    // Adoption -> Network (dashed feedback)
    adoption -> network [label="重塑传播结构", style=dashed, color="#7f8c8d", fontcolor="#7f8c8d"];

    // Additional cross-layer connections
    possibility -> information [label="量化可能性", color="#2980b9", fontcolor="#2c3e50"];
    engineering -> network [label="设计网络拓扑", color="#2c3e50", fontcolor="#2c3e50"];

    // Self-loop for complexity
    complexity -> complexity [label="自组织迭代", style=dashed, color="#7f8c8d", fontcolor="#7f8c8d"];
}
