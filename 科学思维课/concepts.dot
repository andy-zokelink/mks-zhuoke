digraph MKS {
    rankdir=TB;
    fontname="Noto Sans SC";
    node [fontname="Noto Sans SC", fontsize=11, style=filled, penwidth=2];
    edge [fontname="Noto Sans SC", fontsize=9];
    bgcolor="#fdf6ec";

    // Legend subgraph
    subgraph cluster_legend {
        label="图例";
        fontsize=10;
        fontname="Noto Sans SC";
        style="rounded,filled";
        fillcolor="#fffaf2";
        color="#e8d5c4";
        labelloc="t";
        penwidth=1;

        l1 [label="基础方法", shape=box, fillcolor="#3498db", fontcolor=white, width=1.2, height=0.4];
        l2 [label="量化工具", shape=box, fillcolor="#27ae60", fontcolor=white, width=1.2, height=0.4];
        l3 [label="分析方法", shape=box, fillcolor="#e67e22", fontcolor=white, width=1.2, height=0.4];
        l4 [label="世界观层", shape=box, fillcolor="#8e44ad", fontcolor=white, width=1.2, height=0.4];

        l1 -> l2 -> l3 -> l4 [style=invis];
    }

    // Level 1: Foundation
    node1 [label="科学方法\n(可证伪·可迭代)", shape=doubleoctagon, fillcolor="#3498db", fontcolor=white, width=2.2, height=1.0];

    // Level 2: Quantitative Tools
    node2 [label="数量级思维\n(费米估算)", shape=box, fillcolor="#27ae60", fontcolor=white, width=1.8, height=0.8];
    node3 [label="变量隔离\n(控制变量)", shape=box, fillcolor="#27ae60", fontcolor=white, width=1.8, height=0.8];
    node4 [label="严谨测量\n(操作定义)", shape=box, fillcolor="#27ae60", fontcolor=white, width=1.8, height=0.8];

    // Level 3: Analysis Methods
    node5 [label="模型思维\n(简化·预测·修正)", shape=box, fillcolor="#e67e22", fontcolor=white, width=1.9, height=0.8];
    node6 [label="证据金字塔\n(从轶事到荟萃分析)", shape=box, fillcolor="#e67e22", fontcolor=white, width=2.0, height=0.8];
    node7 [label="极限分析\n(渐进·边界)", shape=box, fillcolor="#e67e22", fontcolor=white, width=1.8, height=0.8];

    // Level 4: Worldview
    node8 [label="演化世界观\n(渐变·深时·无目的)", shape=box, fillcolor="#8e44ad", fontcolor=white, width=2.1, height=0.8];
    node9 [label="伪科学识别\n(可证伪·举证责任)", shape=box, fillcolor="#8e44ad", fontcolor=white, width=2.1, height=0.8];
    node10 [label="批判性思维\n(偏见审视·逻辑检验)", shape=box, fillcolor="#8e44ad", fontcolor=white, width=2.1, height=0.8];

    // Edges: Level 1 -> Level 2
    node1 -> node2 [label="量化基础", color="#3498db", fontcolor="#2c3e50"];
    node1 -> node3 [label="控制变量", color="#3498db", fontcolor="#2c3e50"];
    node1 -> node4 [label="操作定义", color="#3498db", fontcolor="#2c3e50"];

    // Edges: Level 2 -> Level 3
    node2 -> node7 [label="数量级边界", color="#27ae60", fontcolor="#2c3e50"];
    node3 -> node5 [label="变量抽象", color="#27ae60", fontcolor="#2c3e50"];
    node4 -> node6 [label="测量→证据", color="#27ae60", fontcolor="#2c3e50"];
    node7 -> node5 [label="边界→建模", color="#e67e22", fontcolor="#2c3e50"];

    // Edges: Level 3 -> Level 4
    node5 -> node8 [label="模型→演化", color="#e67e22", fontcolor="#2c3e50"];
    node6 -> node9 [label="证据→辨伪", color="#e67e22", fontcolor="#2c3e50"];
    node8 -> node10 [label="演化→审视", color="#8e44ad", fontcolor="#2c3e50"];
    node9 -> node10 [label="辨伪→批判", color="#8e44ad", fontcolor="#2c3e50"];

    // Feedback loop (dashed)
    node10 -> node1 [label="反馈迭代", style=dashed, color="#c0392b", fontcolor="#c0392b", penwidth=2];

    // Cross connections
    node2 -> node6 [label="量化评估", style=dotted, color="#7f8c8d", fontcolor="#7f8c8d"];
    node3 -> node6 [label="实验设计", style=dotted, color="#7f8c8d", fontcolor="#7f8c8d"];

    // Peer connections within same level
    node5 -> node6 [label="模型可检验", style=dotted, color="#95a5a6", fontcolor="#7f8c8d"];
    node8 -> node9 [label="演化检验\n伪科学", style=dotted, color="#bdc3c7", fontcolor="#7f8c8d"];
}
